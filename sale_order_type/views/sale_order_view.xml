<odoo>
    <record id="sot_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="priority">15</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field
                    name="type_id"
                    required="order_type_required"
                    readonly="state in ['sale', 'cancel'] or locked"
                />
                <field name="type_precedence" invisible="1" />
                <div
                    name="sot_precedence_hint"
                    colspan="2"
                    class="text-muted small"
                    invisible="not type_id or type_precedence == 'type_first'"
                >
                    <span invisible="type_precedence != 'partner_first'">
                        Pricelist / payment term / warehouse from the partner take precedence over this type's values; the type only fills gaps.
                    </span>
                    <span invisible="type_precedence != 'partner_only'">
                        This type's pricelist / payment term / warehouse are ignored when computing sales-order fields — the type is a labeling construct only.
                    </span>
                </div>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <field name="order_line" position="after">
                <field name="type_id" />
            </field>
            <filter name="order_month" position="after">
                <filter
                    string="Type"
                    name="sale_type"
                    domain="[]"
                    context="{'group_by': 'type_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="sot_view_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.sot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name='name' position="after">
                <field name="type_id" optional="show" />
            </field>
        </field>
    </record>
</odoo>
